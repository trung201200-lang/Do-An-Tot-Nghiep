PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=it_support_rag

JWT_SECRET=
JWT_EXPIRES_IN=1d
SEED_USER_PASSWORD=

# Giai đoạn 5.4: chỉ cấu hình key thật trong .env local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend only. gemini is the default when omitted.
# Select ollama only after manually installing a local model. No provider failover.
RAG_PROVIDER=gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Required when RAG_PROVIDER=ollama: exact locally installed model tag.
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=30000

# Opt-in backend error diagnostics. Both settings are required; disabled in production.
# NODE_ENV=development
RAG_DIAGNOSTICS=false
